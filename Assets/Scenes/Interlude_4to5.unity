    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: nextScene
      value: Stage5_TwilightBridge
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[0].text
      value: "\uAC00\uC9DC \uBCBD\uC758 \uB3D9\uAD74\uC744 \uBE60\uC838\uB098\uC624\uC790,\n\uD558\uB298
        \uB192\uC774 \uC19F\uC740 \uC232\uC774 \uB450 \uC0AC\uB78C\uC744 \uB0B4\uB824\uB2E4\uBCF4\uC558\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[1].text
      value: "\uD669\uD63C\uC758 \uC232\uC740 \uC800 \uAF2D\uB300\uAE30\uC5D0 \uC788\uB2E4\uACE0
        \uD588\uC2B5\uB2C8\uB2E4.\n\uACF5\uC8FC\uB294 \uC655\uC790\uC758 \uC190\uC744
        \uAF49 \uC7A1\uC558\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[5].text
      value: "\uC655\uC88C\uB97C \uB458\uB7EC\uC2FC \uB2E4\uD23C \uC18D\uC5D0\uC11C,
        \uC655\uC790\uB294 \uC78A\uD78C \uD0D1\uC5D0 \uAC07\uD614\uC2B5\uB2C8\uB2E4.\n\uBE5B
        \uD55C \uC904\uAE30 \uC5C6\uB294 \uADF8\uACF3\uC5D0\uC11C, \uADF8\uB294 \uC18C\uB9AC\uAC00
        \uB418\uB3CC\uC544\uC624\uB294 \uBA54\uC544\uB9AC\uB85C \uC138\uC0C1\uC744
        \uBCF4\uB294 \uBC95\uC744 \uC775\uD614\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[6].text
      value: "\uC624\uB79C \uC138\uC6D4\uC5D0 \uD0D1\uC774 \uBB34\uB108\uC9C0\uB358
        \uB0A0,\n\uC655\uC790\uB294 \uBA54\uC544\uB9AC\uC5D0 \uAE30\uB300\uC5B4 \uBC16\uC73C\uB85C
        \uB098\uC640 \uC815\uCC98 \uC5C6\uC774 \uAC78\uC5C8\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[10].text
      value: "\uD669\uD63C\uC758 \uC232 \uAE4A\uC740 \uACF3\uC5D0\uB294 \uD669\uD63C\uC758
        \uB9C8\uB140\uAC00 \uC0B0\uB2E4\uACE0 \uD569\uB2C8\uB2E4. \uB208\uC744 \uACE0\uCCD0
