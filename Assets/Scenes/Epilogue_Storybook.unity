    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[0].text
      value: "\uD669\uD63C\uC758 \uC232 \uAC00\uC7A5 \uAE4A\uC740 \uACF3\uC5D0\uC11C,\n\uB450
        \uC0AC\uB78C\uC740 \uB9C8\uCE68\uB0B4 \uC0D8\uC5D0 \uB2FF\uC558\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[1].text
      value: "\uC0D8\uBB3C\uC740 \uB2E8 \uD55C \uBAA8\uAE08. \uD55C \uC0AC\uB78C\uC758
        \uB208\uC774\uB098, \uD55C \uC0AC\uB78C\uC758 \uADC0\uB97C \uACE0\uCE60 \uB9CC\uD07C\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC655\uC790\uB294
        \uB9DD\uC124\uC784 \uC5C6\uC774 \uADF8 \uC794\uC744 \uACF5\uC8FC\uC5D0\uAC8C
        \uB0B4\uBC00\uC5C8\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[2].text
      value: "\uACF5\uC8FC\uB294 \uC794\uC744 \uD55C\uCC38 \uB0B4\uB824\uB2E4\uBCF4\uB2E4\uAC00\u2026
        \uC0D8\uC5D0 \uB3C4\uB85C \uBD80\uC5B4 \uBC84\uB838\uC2B5\uB2C8\uB2E4.\n\uC774\uC81C
        \uC640\uC11C \uB2EC\uB77C\uC9C8 \uAC83\uC740 \uC5C6\uC5C8\uC73C\uB2C8\uAE4C\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[3].text
      value: "\uC228\uC740 \uAE38\uC740 \uC655\uC790\uAC00 \uCC3E\uC544\uB0B4\uACE0,
        \uBB34\uAC70\uC6B4 \uAC83\uC740 \uACF5\uC8FC\uAC00 \uC62E\uACBC\uC2B5\uB2C8\uB2E4.\n\uB450
        \uC0AC\uB78C\uC740 \uC774\uBBF8, \uC11C\uB85C\uC758 \uB208\uACFC \uADC0\uC600\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 719843348653090854, guid: ad957e694b3c69d4ca318bcb2e5e494e, type: 3}
      propertyPath: pages.Array.data[4].text
      value: "\uADF8\uB0A0 \uACF5\uC8FC\uB294 \uCC98\uC74C\uC73C\uB85C \uC18C\uB9AC
        \uB0B4\uC5B4 \uC6C3\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC790\uAE30 \uADC0\uC5D0\uB294
