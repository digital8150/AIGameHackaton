--- !u!114 &719843348653090854
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 777688313496894866}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf919f965170234dad7270c2895d9c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DuskTwilight.StorybookCutscene
  pages:
  - picture: {fileID: 2800000, guid: eba5169509ee30f45991c318c499fa51, type: 3}
    text: "<size=88>\uD669\uD63C\uC758 \uADF8\uB9BC\uCC45</size>\n\uAC00\uC7A5 \uC5B4\uB450\uC6B4
      \uC0C8\uBCBD\uBD80\uD130 \uB208\uBD80\uC2E0 \uBC24\uAE4C\uC9C0, \uC804\uD574
      \uB0B4\uB824\uC628 \uC774\uC57C\uAE30."
  - picture: {fileID: 2800000, guid: 5295938c830903e4ba31e414b3053bcc, type: 3}
    text: "\uBE5B\uC758 \uB098\uB77C\uC640 \uC5B4\uB460\uC758 \uB098\uB77C\uB294,
      \uC601\uC6D0\uC758 \uD22C\uC7C1\uC744 \uC774\uC5B4\uAC14\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: 255ab8e483c2c664990655b70d2ebb37, type: 3}
    text: "\uC5B4\uB460\uC758 \uB098\uB77C\uC758 \uC2B9\uB9AC\uC758 \uC9C0\uD45C.
      \uC804\uC7A5\uC758 \uACF5\uC8FC\uB294 \uADF8 \uB204\uAD6C\uBCF4\uB2E4 \uC794\uD559\uD558\uACE0
      \uC6A9\uB9F9\uD588\uC9C0\uB9CC\n\uD3EC\uC131\uC5D0 \uCCAD\uAC01\uC744 \uC783\uC790\u2026
      \uC4F8\uBAA8\uAC00 \uB2E4\uD588\uB2E4\uACE0 \uC5EC\uACA8\uC838, \uBC84\uB9BC\uBC1B\uC558\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: 7d31421238da45742a746701655d3dee, type: 3}
    text: "\uADF8\uB140\uAC00 \uB2FF\uC740 \uACF3\uC740,\n\uD55C\uBC88 \uB4E4\uC5B4\uAC00\uBA74
      \uC544\uBB34\uB3C4 \uB3CC\uC544\uC624\uC9C0 \uBABB\uD55C\uB2E4\uB294 \uC800\uC8FC\uBC1B\uC740
      \uC232\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: 1b10ebcdc80d90c49859065f9f71e19e, type: 3}
    text: "\uBE5B\uC758 \uB098\uB77C\uC758 \uC655\uC790\uB294 \uC5B4\uB460 \uC18D
      \uC790\uAC1D\uC758 \uCE7C\uB05D\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC558\uC9C0\uB9CC,\n\uB450
      \uB208\uC758 \uBE5B\uC744 \uC783\uC5C8\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: a8f07e4ac30b9bc40ab8bc7ed87dd031, type: 3}
    text: "\uC655\uC88C\uB97C \uB458\uB7EC\uC2FC \uB2E4\uD23C \uC18D\uC5D0\uC11C,
      \uC655\uC790\uB294 \uC78A\uD78C \uD0D1\uC5D0 \uAC07\uD614\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: 2a5cab0ff1d89fd46864b5f2e43f008c, type: 3}
    text: "\uC624\uB79C \uC138\uC6D4\uC5D0 \uD0D1\uC774 \uBB34\uB108\uC9C0\uB358
      \uB0A0,\n\uC655\uC790\uB294 \uB354\uB4EC\uB354\uB4EC \uBC16\uC73C\uB85C \uB098\uC640
      \uC815\uCC98 \uC5C6\uC774 \uAC78\uC5C8\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: 2268bbadee8f9c042b22f999137ea879, type: 3}
    text: "\uADF8\uB9AC\uACE0 \uC815\uCC98 \uC5C6\uB358 \uC655\uC790\uC758 \uBC1C\uAE38
      \uB610\uD55C,\n\uADF8 \uC800\uC8FC\uBC1B\uC740 \uC232\uC5D0 \uB2FF\uC558\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: f24a768e7bbb2ea498a5d5be1986ff2a, type: 3}
    text: "\uADF8\uACF3\uC5D0\uC11C \uACF5\uC8FC\uB294 \uBE5B\uC758 \uB098\uB77C
      \uC655\uC790\uC640 \uB9C8\uC8FC\uCCE4\uC2B5\uB2C8\uB2E4.\n\uCE7C\uC744 \uACA8\uB234\uC9C0\uB9CC\u2026
      \uC774\uC81C \uC640\uC11C \uB2EC\uB77C\uC9C8 \uAC83\uC740 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: e795051a9c56e8d48990e9e6f8c12aea, type: 3}
    text: "\uC655\uC790\uAC00 \uBB34\uC5B4\uB77C \uB9D0\uD588\uC9C0\uB9CC, \uACF5\uC8FC\uC5D0\uAC8C\uB294
      \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\uADF8\uC800 \uADF8 \uC5BC\uAD74\uC774,
      \uB300\uCC45 \uC5C6\uC774 \uD574\uB9D1\uC558\uC744 \uBFD0."
  - picture: {fileID: 2800000, guid: c08bd7eeebd474f44b29865be8967abe, type: 3}
    text: "\uD669\uD63C\uC758 \uC232 \uAE4A\uC740 \uACF3\uC5D0\uB294 \uB208\uC744
      \uACE0\uCCD0 \uC8FC\uB294 \uC0D8\uC774 \uC788\uB2E4\uACE0 \uD569\uB2C8\uB2E4.\n\uC655\uC790\uB294
      \uC5B4\uB450\uC6B4 \uC232 \uB108\uBA38\uB97C \uAC00\uB9AC\uD0A4\uBA70, \uB4E4\uB9AC\uC9C0\uB3C4
      \uC54A\uB294 \uC774\uC57C\uAE30\uB97C \uC2E0\uB098\uAC8C \uB298\uC5B4\uB193\uC558\uC2B5\uB2C8\uB2E4."
  - picture: {fileID: 2800000, guid: f15e520f10390c14d9f36b48565b7f80, type: 3}
    text: "\uADF8 \uAE38\uC5D0\uB294 \uC2E0\uBE44\uB85C\uC6B4 \uD568\uC815\uC774
      \uAC00\uB4DD\uD588\uACE0,\n\uBCF4\uB2E4 \uBABB\uD55C \uACF5\uC8FC\uB294 \uD55C\uC228\uC744
      \uC26C\uBA70 \uADF8 \uB4A4\uB97C \uB530\uB790\uC2B5\uB2C8\uB2E4."
  under: {fileID: 7394685588321008315}
  over: {fileID: 593352113341996898}
