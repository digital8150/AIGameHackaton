  thinkingText: "\uC54C\uC544\uB4E3\uB294 \uC911\u2026"
  loadingText: "\uC74C\uC131 \uC778\uC2DD\uC744 \uC900\uBE44\uD558\uACE0 \uC788\uC5B4\uC694\u2026"
  noMicText: "\uB9C8\uC774\uD06C\uB97C \uCC3E\uC9C0 \uBABB\uD588\uC5B4\uC694. \uBAA9\uC18C\uB9AC
    \uC5C6\uC774\uB3C4 \uB05D\uAE4C\uC9C0 \uAC08 \uC218 \uC788\uC5B4\uC694."
